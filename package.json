{
  "name": "accessfix-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Scan HTML for WCAG 2.2 violations, then have an AI agent fix the markup — local CLI MVP.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "scan": "tsx src/cli.ts scan",
    "fix": "tsx src/cli.ts fix",
    "check": "tsx src/cli.ts check",
    "test": "node --import tsx --test src/scanner/*.test.ts src/report/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "cheerio": "^1.0.0",
    "diff": "^7.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
